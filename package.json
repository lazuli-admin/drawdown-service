{
  "name": "drawdown-service",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test src/math.test.ts",
    "serve": "node src/server.ts",
    "dev": "concurrently -k -n api,web \"node src/server.ts\" \"vite\" 2>&1 | tee .dev.log",
    "env:pull": "infisical export --projectId=3f4a5caa-157d-4636-a502-990ab9d3a072 --env=dev --format=dotenv --silent | sed \"s/='\\(.*\\)'$/=\\1/\" > .env"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "dotenv": "^17.4.2",
    "node-cron": "^4.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "vite": "^8.3.0"
  }
}
